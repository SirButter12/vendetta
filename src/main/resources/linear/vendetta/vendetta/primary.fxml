<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootPane" minHeight="520.0" minWidth="900.0" prefHeight="580.0" prefWidth="1030.0" spacing="4.0" stylesheets="@vendetta.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="linear.vendetta.vendetta.PrimaryController">
   <children>

      <HBox prefHeight="320.0" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>

            <!-- Columna Matrices -->
            <VBox alignment="TOP_CENTER" prefWidth="150.0" styleClass="panel">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <children>
                  <Label styleClass="panel-title" text="Matrices" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="matricesBox" alignment="TOP_CENTER" spacing="20.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <VBox alignment="TOP_CENTER" prefWidth="140.0" styleClass="panel">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <children>
                  <Label styleClass="panel-title" text="Vectors" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="vectorsBox" alignment="TOP_CENTER" spacing="20.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <Pane fx:id="graphPane" minHeight="250.0" minWidth="300.0" styleClass="graph-pane" HBox.hgrow="ALWAYS" />

         </children>
      </HBox>

      <HBox prefHeight="256.0" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>

            <VBox prefWidth="290.0" styleClass="panel">
               <children>
                  <HBox spacing="2.0">
                     <children>
                        <Button fx:id="clearButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onClear" prefHeight="38.0" styleClass="tool-button" text="Clear" HBox.hgrow="ALWAYS" />
                        <Button fx:id="compileButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCompile" prefHeight="38.0" styleClass="tool-button" text="Compile" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <ScrollPane fx:id="outputScroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="outputBox" spacing="10.0">
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <ScrollPane fx:id="inputScroll" fitToWidth="true" styleClass="panel" HBox.hgrow="ALWAYS">
               <content>
                  <VBox>
                     <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                     <children>
                        <Label alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="panel-title" text="Input:" />
                        <VBox fx:id="commandsBox" spacing="0.0" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>

         </children>
      </HBox>

   </children>
</VBox>
